def column (v : V) : Nat := columns.getD v.val 0
def input (r : RowIndex) (v : V) : Bool := (column v).testBit r.val

def neighborColumn : List V → Nat
  | [] => 0
  | v :: vs => column v ||| neighborColumn vs

theorem neighbor_bit (r : RowIndex) (vs : List V) :
    (neighborColumn vs).testBit r.val = true ↔ ∃ v ∈ vs, input r v = true := by
  induction vs with
  | nil => simp [neighborColumn]
  | cons v vs ih => simp [neighborColumn, ih, input]

set_option maxRecDepth 32000 in
theorem exhaustiveColumns : ∀ v : V,
    column v &&& neighborColumn (adjacent v) = 0 ∧
    column v ||| neighborColumn (adjacent v) = 2^25237 - 1 := by
  decide +kernel

theorem covered (r : RowIndex) (v : V) :
    (∃ w ∈ adjacent v, input r w = true) ↔ input r v = false := by
  rw [← neighbor_bit]
  obtain ⟨disjoint, full⟩ := exhaustiveColumns v
  have h₁ := congrArg (fun n : Nat => n.testBit r.val) disjoint
  have h₂ := congrArg (fun n : Nat => n.testBit r.val) full
  simp only [Nat.testBit_and, Nat.zero_testBit] at h₁
  simp only [Nat.testBit_or, Nat.testBit_two_pow_sub_one, decide_eq_true r.isLt] at h₂
  unfold input
  revert h₁ h₂
  cases (column v).testBit r.val <;> cases (neighborColumn (adjacent v)).testBit r.val <;> decide

-- Read the columns as a binary integer with the most significant place first.
def value : List Nat → Nat → Nat
  | [], _ => 0
  | c :: cs, r => (if c.testBit r then 2^cs.length else 0) + value cs r

theorem valueBound (cs : List Nat) (r : Nat) : value cs r < 2^cs.length := by
  induction cs with
  | nil => simp [value]
  | cons c cs ih =>
    cases h : c.testBit r <;> simp [value, h, Nat.pow_succ] <;> omega

-- Bit r of increasing encodes the comparison between rows r and r + 1.
def increasing : List Nat → Nat
  | [] => 0
  | c :: cs =>
    let next := c >>> 1
    let diff := c ^^^ next
    let tail := increasing cs
    (diff &&& next) ||| (tail ^^^ (tail &&& diff))

theorem increasing_spec (cs : List Nat) (r : Nat) :
    (increasing cs).testBit r = true ↔ value cs r < value cs (r+1) := by
  induction cs with
  | nil => simp [increasing, value]
  | cons c cs ih =>
    have leftBound := valueBound cs r
    have rightBound := valueBound cs (r+1)
    cases a : c.testBit r <;> cases b : c.testBit (r+1) <;>
      cases t : (increasing cs).testBit r <;>
      simp_all [increasing, value, Nat.add_comm 1 r] <;> omega

set_option maxRecDepth 32000 in
theorem comparisons : increasing columns = 2^25236 - 1 := by decide +kernel

theorem rowOrder : StrictMono (fun r : RowIndex => value columns r.val) := by
  apply Fin.strictMono_iff_lt_succ.mpr
  intro i
  apply (increasing_spec columns i.val).1
  rw [comparisons, Nat.testBit_two_pow_sub_one]
  exact decide_eq_true i.isLt

theorem valueCongr {a b : Nat} (cs : List Nat) (h : ∀ c ∈ cs, c.testBit a = c.testBit b) :
    value cs a = value cs b := by
  induction cs with
  | nil => rfl
  | cons c cs ih =>
    rw [value, value, h c (.head cs), ih (fun z hz => h z (.tail _ hz))]

theorem distinctInputs : Function.Injective input := by
  intro a b h
  apply rowOrder.injective
  apply valueCongr
  intro c hc
  obtain ⟨j,rfl⟩ := List.mem_iff_get.mp hc
  let v : V := ⟨j.val, j.isLt⟩
  have bit := congrFun h v
  simpa [v, input, column, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem j.isLt] using bit

def MaxFalse (C : Circuit) := {x : V → Bool | C.eval (List.ofFn x) = false ∧
  ∀ y : V → Bool, (∀ v, x v = true → y v = true) → C.eval (List.ofFn y) = false → y = x}

theorem family (C : Circuit) (computes : ∀ x : V → Bool, C.eval (List.ofFn x) = true ↔
    ∃ u v : V, (u.val,v.val) ∈ edges ∧ x u = true ∧ x v = true) (r : RowIndex) :
    input r ∈ MaxFalse C := by
  constructor
  · apply Bool.eq_false_iff.mpr
    intro accepted
    obtain ⟨u,v,edge,hu,hv⟩ := (computes _).1 accepted
    have hadj := (adjacent_spec u v).2 (Or.inl edge)
    have hfalse := (covered r u).1 ⟨v,hadj,hv⟩
    exact Bool.noConfusion (hfalse.symm.trans hu)
  · intro y enlarges rejected
    funext u
    cases hu : input r u with
    | true => exact enlarges u hu
    | false =>
      apply Bool.eq_false_iff.mpr
      intro added
      obtain ⟨v, hadj, hv⟩ := (covered r u).2 hu
      have present : ∃ p l : V, (p.val,l.val) ∈ edges ∧ y p = true ∧ y l = true := by
        rcases (adjacent_spec u v).1 hadj with fwd | rev
        · exact ⟨u,v,fwd,added,enlarges v hv⟩
        · exact ⟨v,u,rev,enlarges v hv,added⟩
      exact Bool.noConfusion (rejected.symm.trans ((computes y).2 present))

theorem countFamily (C : Circuit) (computes : ∀ x : V → Bool, C.eval (List.ofFn x) = true ↔
    ∃ u v : V, (u.val,v.val) ∈ edges ∧ x u = true ∧ x v = true) : 25237 ≤ (MaxFalse C).ncard := by
  have subset : Set.range input ⊆ MaxFalse C := by
    rintro x ⟨r,rfl⟩
    exact family C computes r
  have h := Set.ncard_le_ncard subset
  rw [Set.ncard_range_of_injective distinctInputs] at h
  simpa using h


theorem atLeastFifteen (C : Circuit) (hm : PEqualNP.MetaComplexity.Monotone2 C)
    (computes : ∀ x : V → Bool, C.eval (List.ofFn x) = true ↔
      ∃ u v : V, (u.val,v.val) ∈ edges ∧ x u = true ∧ x v = true) :
    15 ≤ {j : Fin C.gates.length | (C.gates.get j).op = GateOp.and}.ncard := by
  classical
  by_contra! small
  let B := Finset.univ.filter fun j : Fin C.gates.length => (C.gates.get j).op = GateOp.and
  have eqB : (B : Set (Fin C.gates.length)) = {j | (C.gates.get j).op = GateOp.and} := by
    ext j
    simp [B]
  have hB : B.card ≤ 14 := by
    rw [← Set.ncard_coe_finset, eqB]
    omega
  have bound := maxFalseBound 42 14 C hm (by
    refine ⟨B.image Fin.val, (Finset.card_image_le.trans hB), ?_⟩
    intro j g hg hand
    obtain ⟨hj, hjg⟩ := List.getElem?_eq_some_iff.mp hg
    refine Finset.mem_image.mpr ⟨⟨j,hj⟩, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩, rfl⟩
    change C.gates[j].op = GateOp.and
    rw [hjg, hand])
  change (MaxFalse C).ncard ≤ 2^14 at bound
  have tooMany := countFamily C computes
  omega

end PEqualNP.Outside.L_meta_7025_aux

