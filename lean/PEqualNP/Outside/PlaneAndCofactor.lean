def column (v : V) : Nat := columns.getD v.val 0
def input (r : RowIndex) (v : V) : Bool := (column v).testBit r.val

def neighborColumn : List V → Nat
  | [] => 0
  | v :: vs => column v ||| neighborColumn vs

theorem neighbor_bit (r : RowIndex) (vs : List V) :
    (neighborColumn vs).testBit r.val = true ↔ ∃ v ∈ vs, input r v = true := by
  induction vs with
  | nil => simp [neighborColumn]
  | cons v vs ih => simp [neighborColumn, ih, input]

set_option maxRecDepth 32000 in
theorem exhaustiveColumns : ∀ v : V,
    column v &&& neighborColumn (restrictNeighbors 0 v) = 0 ∧
    column v ||| neighborColumn (restrictNeighbors 0 v) = 2^20406 - 1 := by
  decide +kernel

theorem covered (r : RowIndex) (v : V) :
    (∃ w ∈ restrictNeighbors 0 v, input r w = true) ↔ input r v = false := by
  rw [← neighbor_bit]
  obtain ⟨disjoint, full⟩ := exhaustiveColumns v
  have h₁ := congrArg (fun n : Nat => n.testBit r.val) disjoint
  have h₂ := congrArg (fun n : Nat => n.testBit r.val) full
  simp only [Nat.testBit_and, Nat.zero_testBit] at h₁
  simp only [Nat.testBit_or, Nat.testBit_two_pow_sub_one, decide_eq_true r.isLt] at h₂
  unfold input
  revert h₁ h₂
  cases (column v).testBit r.val <;> cases (neighborColumn (restrictNeighbors 0 v)).testBit r.val <;> decide

set_option maxRecDepth 32000 in
theorem comparisons : increasing columns = 2^20405 - 1 := by decide +kernel

theorem rowOrder : StrictMono (fun r : RowIndex => value columns r.val) := by
  apply Fin.strictMono_iff_lt_succ.mpr
  intro i
  apply (increasing_spec columns i.val).1
  rw [comparisons, Nat.testBit_two_pow_sub_one]
  exact decide_eq_true i.isLt

theorem distinctInputs : Function.Injective input := by
  intro a b h
  apply rowOrder.injective
  apply valueCongr
  intro c hc
  obtain ⟨j,rfl⟩ := List.mem_iff_get.mp hc
  let v : V := ⟨j.val, j.isLt⟩
  have bit := congrFun h v
  simpa [v, input, column, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem j.isLt] using bit


-- A cyclic translation for a pinned point, and the order-reversing point-line
-- duality for a pinned line. Each map takes the pinned vertex to vertex 0.
def relabel (t u : V) : V :=
  let i := if t.val < 21 then (u.val + 21 - t.val) % 21
           else (t.val + 21 - u.val % 21) % 21
  let upper := (decide (t.val < 21)) != (decide (u.val < 21))
  ⟨(if upper then 21 else 0) + i, by
    have hi : i < 21 := by dsimp [i]; split <;> exact Nat.mod_lt _ (by decide)
    split <;> omega⟩

set_option maxHeartbeats 3000000 in
theorem relabels : ∀ t : V, (∀ a : V, ∃ b : V, relabel t b = a) ∧
    ∀ u : V, ((restrictNeighbors t u).map (relabel t)).toFinset =
      (restrictNeighbors 0 (relabel t u)).toFinset := by decide +kernel

def witness (t : V) (r : RowIndex) (u : V) := input r (relabel t u)

theorem witnessCovered (t : V) (r : RowIndex) (u : V) :
    (∃ w ∈ restrictNeighbors t u, witness t r w = true) ↔ witness t r u = false := by
  have maps := (relabels t).2 u
  rw [witness, ← covered]
  constructor
  · rintro ⟨w,hw,bit⟩
    refine ⟨relabel t w, List.mem_toFinset.mp ?_, bit⟩
    rw [← maps]
    exact List.mem_toFinset.mpr (List.mem_map.mpr ⟨_,hw,rfl⟩)
  · rintro ⟨w,hw,bit⟩
    have hm := List.mem_toFinset.mpr hw
    rw [← maps] at hm
    obtain ⟨z,hz,rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hm)
    exact ⟨z,hz,bit⟩

theorem witnessInjective (t : V) : Function.Injective (witness t) := by
  intro a b same
  apply distinctInputs
  funext u
  obtain ⟨v,rfl⟩ := (relabels t).1 u
  exact congrFun same v

theorem countFamily (t : V) (C : Circuit) (computes : ∀ x : V → Bool, C.eval (List.ofFn x) = true ↔
    ∃ u v : V, v ∈ restrictNeighbors t u ∧ x u = true ∧ x v = true) :
    20406 ≤ (MaxFalse C).ncard := by
  have subset : Set.range (witness t) ⊆ MaxFalse C := by
    rintro _ ⟨r,rfl⟩
    constructor
    · apply Bool.eq_false_iff.mpr
      intro accepted
      obtain ⟨u,v,edge,hu,hv⟩ := (computes _).1 accepted
      have hfalse := (witnessCovered t r u).1 ⟨v,edge,hv⟩
      exact Bool.noConfusion (hfalse.symm.trans hu)
    · intro y enlarges rejected
      funext u
      cases hu : witness t r u with
      | true => exact enlarges u hu
      | false =>
        apply Bool.eq_false_iff.mpr
        intro added
        obtain ⟨v,edge,hv⟩ := (witnessCovered t r u).2 hu
        exact Bool.noConfusion (rejected.symm.trans ((computes y).2 ⟨u,v,edge,added,enlarges v hv⟩))
  have h := Set.ncard_le_ncard subset
  rw [Set.ncard_range_of_injective (witnessInjective t)] at h
  simpa using h

theorem atLeastFifteen (t : V) (C : Circuit) (hm : PEqualNP.MetaComplexity.Monotone2 C)
    (computes : ∀ x : V → Bool, C.eval (List.ofFn x) = true ↔
      ∃ u v : V, v ∈ restrictNeighbors t u ∧ x u = true ∧ x v = true) :
    15 ≤ {j : Fin C.gates.length | (C.gates.get j).op = GateOp.and}.ncard := by
  classical
  by_contra! small
  let B := Finset.univ.filter fun j : Fin C.gates.length => (C.gates.get j).op = GateOp.and
  have eqB : (B : Set (Fin C.gates.length)) = {j | (C.gates.get j).op = GateOp.and} := by
    ext j
    simp [B]
  have hB : B.card ≤ 14 := by
    rw [← Set.ncard_coe_finset, eqB]
    omega
  have bound := maxFalseBound 42 14 C hm (by
    refine ⟨B.image Fin.val, (Finset.card_image_le.trans hB), ?_⟩
    intro j g hg hand
    obtain ⟨hj, hjg⟩ := List.getElem?_eq_some_iff.mp hg
    refine Finset.mem_image.mpr ⟨⟨j,hj⟩, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩, rfl⟩
    change C.gates[j].op = GateOp.and
    rw [hjg, hand])
  change (MaxFalse C).ncard ≤ 2^14 at bound
  have tooMany := countFamily t C computes
  omega

def pinLow (t : V) (x : V → Bool) (u : V) : Bool := if u = t then false else x u

def Incidence (x : V → Bool) := ∃ p l : V, (p.val,l.val) ∈ edges ∧ x p = true ∧ x l = true

theorem memRestricted (t u v : V) : v ∈ restrictNeighbors t u ↔
    u ≠ t ∧ v ≠ t ∧ v ∈ adjacent u := by
  by_cases e : u = t <;> simp [restrictNeighbors, e, and_comm]

theorem pinSpec (t : V) (x : V → Bool) : Incidence (pinLow t x) ↔
    ∃ u v : V, v ∈ restrictNeighbors t u ∧ x u = true ∧ x v = true := by
  constructor
  · rintro ⟨p,l,edge,hp,hl⟩
    have a : p ≠ t := by rintro rfl; simp [pinLow] at hp
    have b : l ≠ t := by rintro rfl; simp [pinLow] at hl
    exact ⟨p,l,(memRestricted t p l).2 ⟨a,b,(adjacent_spec p l).2 (Or.inl edge)⟩,
      by simpa [pinLow,a] using hp, by simpa [pinLow,b] using hl⟩
  · rintro ⟨u,v,neighbor,hu,hv⟩
    obtain ⟨a,b,h⟩ := (memRestricted t u v).1 neighbor
    have up : pinLow t x u = true := by simpa [pinLow,a] using hu
    have vp : pinLow t x v = true := by simpa [pinLow,b] using hv
    rcases (adjacent_spec u v).1 h with e | e
    · exact ⟨u,v,e,up,vp⟩
    · exact ⟨v,u,e,vp,up⟩

theorem pinnedAndLowerBound (t : V) (C : Circuit) (hm : PEqualNP.MetaComplexity.Monotone2 C)
    (computes : ∀ x : V → Bool, C.eval (List.ofFn x) = true ↔ Incidence (pinLow t x)) :
    15 ≤ {j : Fin C.gates.length | (C.gates.get j).op = GateOp.and}.ncard :=
  atLeastFifteen t C hm (fun x => (computes x).trans (pinSpec t x))

-- In particular, no circuit with exactly fifteen AND gates admits a cheaper
-- monotone realization after restricting a single raw input to false.
theorem cannotSaveAnd (t : V) (C D : Circuit) (hD : PEqualNP.MetaComplexity.Monotone2 D)
    (computes : ∀ x : V → Bool, C.eval (List.ofFn x) = true ↔ Incidence x)
    (equiv : ∀ x : V → Bool, D.eval (List.ofFn x) = C.eval (List.ofFn (pinLow t x)))
    (fifteen : {j : Fin C.gates.length | (C.gates.get j).op = GateOp.and}.ncard = 15) :
    {j : Fin C.gates.length | (C.gates.get j).op = GateOp.and}.ncard ≤
    {j : Fin D.gates.length | (D.gates.get j).op = GateOp.and}.ncard := by
  rw [fifteen]
  exact pinnedAndLowerBound t D hD (fun x => (equiv x) ▸ computes (pinLow t x))

end PEqualNP.Outside.PlaneAndCofactor

