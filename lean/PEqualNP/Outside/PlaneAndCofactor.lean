-- With vertex 0 pinned low, its wire is irrelevant to the output. In a maximal
-- false input on all 42 wires its otherwise irrelevant coordinate must be true.
abbrev RowIndex := Fin 20406

def restrictNeighbors (t u : V) : List V :=
  if u = t then [] else (adjacent u).filter (· != t)

